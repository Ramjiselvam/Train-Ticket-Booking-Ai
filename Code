import React, { useState, useEffect } from 'react';
import { Train, Clock, Users, Calendar, Search, Zap, Bell, CheckCircle, AlertCircle } from 'lucide-react';

const TatkalBookingApp = () => {
  const [activeTab, setActiveTab] = useState('search');
  const [formData, setFormData] = useState({
    from: '',
    to: '',
    date: '',
    class: 'SL',
    quota: 'TATKAL'
  });
  const [trains, setTrains] = useState([]);
  const [bookingAttempts, setBookingAttempts] = useState([]);
  const [aiSuggestions, setAiSuggestions] = useState([]);
  const [notifications, setNotifications] = useState([]);

  // Simulated train data
  const mockTrains = [
    { number: '12301', name: 'Rajdhani Express', from: 'NDLS', to: 'HWH', departure: '16:55', arrival: '10:05', duration: '17h 10m', tatkalOpen: '10:00 AM', available: { SL: 15, 3A: 8, 2A: 3 } },
    { number: '12302', name: 'Duronto Express', from: 'NDLS', to: 'HWH', departure: '22:15', arrival: '14:30', duration: '16h 15m', tatkalOpen: '10:00 AM', available: { SL: 7, 3A: 2, 2A: 0 } },
    { number: '12951', name: 'Mumbai Rajdhani', from: 'NDLS', to: 'MMCT', departure: '16:30', arrival: '08:35', duration: '16h 05m', tatkalOpen: '10:00 AM', available: { SL: 23, 3A: 12, 2A: 5 } },
    { number: '12260', name: 'Shatabdi Express', from: 'NDLS', to: 'BPL', departure: '06:00', arrival: '13:50', duration: '07h 50m', tatkalOpen: '10:00 AM', available: { CC: 18, EC: 4 } }
  ];

  const stations = [
    { code: 'NDLS', name: 'New Delhi' },
    { code: 'HWH', name: 'Howrah' },
    { code: 'MMCT', name: 'Mumbai Central' },
    { code: 'BPL', name: 'Bhopal' },
    { code: 'PUNE', name: 'Pune' },
    { code: 'MAA', name: 'Chennai' },
    { code: 'BLR', name: 'Bangalore' }
  ];

  const classes = ['SL', '3A', '2A', '1A', 'CC', 'EC'];
  const quotas = ['TATKAL', 'PREMIUM TATKAL', 'GENERAL'];

  useEffect(() => {
    // Simulate AI suggestions
    const suggestions = [
      { type: 'success', text: 'Best time to book: Tatkal opens at 10:00 AM. Be ready 2 minutes early!' },
      { type: 'info', text: 'Train 12301 has 85% success rate for Tatkal bookings' },
      { type: 'warning', text: 'High demand route! Consider alternate trains or dates' }
    ];
    setAiSuggestions(suggestions);

    // Simulate notifications
    const notifs = [
      { id: 1, text: 'Tatkal booking opens in 2 hours for your selected date', time: '2m ago', read: false },
      { id: 2, text: 'Price drop alert: Premium Tatkal reduced by ₹200', time: '1h ago', read: false }
    ];
    setNotifications(notifs);
  }, []);

  const handleSearch = () => {
    setTrains(mockTrains);
    setActiveTab('results');
  };

  const handleAutoBook = (train) => {
    const attempt = {
      id: Date.now(),
      trainNumber: train.number,
      trainName: train.name,
      status: 'scheduled',
      scheduledTime: train.tatkalOpen,
      class: formData.class
    };
    setBookingAttempts([...bookingAttempts, attempt]);
    setActiveTab('autobook');
    
    // Simulate status updates
    setTimeout(() => {
      setBookingAttempts(prev => prev.map(a => 
        a.id === attempt.id ? { ...a, status: 'attempting' } : a
      ));
    }, 2000);
    
    setTimeout(() => {
      setBookingAttempts(prev => prev.map(a => 
        a.id === attempt.id ? { ...a, status: 'success', pnr: 'PNR-' + Math.random().toString(36).substr(2, 10).toUpperCase() } : a
      ));
    }, 4000);
  };

  const getStatusColor = (status) => {
    switch(status) {
      case 'scheduled': return 'bg-blue-100 text-blue-800';
      case 'attempting': return 'bg-yellow-100 text-yellow-800';
      case 'success': return 'bg-green-100 text-green-800';
      case 'failed': return 'bg-red-100 text-red-800';
      default: return 'bg-gray-100 text-gray-800';
    }
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-orange-50 via-white to-green-50">
      {/* Header */}
      <div className="bg-gradient-to-r from-orange-600 to-orange-500 text-white shadow-lg">
        <div className="max-w-7xl mx-auto px-4 py-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center space-x-3">
              <Train className="w-8 h-8" />
              <div>
                <h1 className="text-2xl font-bold">TatkalAI</h1>
                <p className="text-sm text-orange-100">Smart Tatkal Booking Assistant</p>
              </div>
            </div>
            <div className="relative">
              <Bell className="w-6 h-6 cursor-pointer" />
              {notifications.filter(n => !n.read).length > 0 && (
                <span className="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
                  {notifications.filter(n => !n.read).length}
                </span>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* Tabs */}
      <div className="bg-white shadow-sm border-b">
        <div className="max-w-7xl mx-auto px-4">
          <div className="flex space-x-8">
            {['search', 'results', 'autobook'].map(tab => (
              <button
                key={tab}
                onClick={() => setActiveTab(tab)}
                className={`py-4 px-2 border-b-2 font-medium transition-colors ${
                  activeTab === tab
                    ? 'border-orange-500 text-orange-600'
                    : 'border-transparent text-gray-500 hover:text-gray-700'
                }`}
              >
                {tab === 'search' && 'Search Trains'}
                {tab === 'results' && 'Available Trains'}
                {tab === 'autobook' && 'Auto-Book Queue'}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 py-6">
        {/* AI Suggestions Banner */}
        <div className="mb-6 space-y-2">
          {aiSuggestions.map((suggestion, idx) => (
            <div
              key={idx}
              className={`flex items-start space-x-3 p-4 rounded-lg ${
                suggestion.type === 'success' ? 'bg-green-50 border border-green-200' :
                suggestion.type === 'warning' ? 'bg-yellow-50 border border-yellow-200' :
                'bg-blue-50 border border-blue-200'
              }`}
            >
              <Zap className="w-5 h-5 text-orange-600 mt-0.5 flex-shrink-0" />
              <p className="text-sm font-medium text-gray-800">{suggestion.text}</p>
            </div>
          ))}
        </div>

        {/* Search Form */}
        {activeTab === 'search' && (
          <div className="bg-white rounded-xl shadow-lg p-6">
            <h2 className="text-xl font-bold mb-6 flex items-center">
              <Search className="w-6 h-6 mr-2 text-orange-600" />
              Search Tatkal Trains
            </h2>
            
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">From Station</label>
                <select
                  value={formData.from}
                  onChange={(e) => setFormData({...formData, from: e.target.value})}
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                >
                  <option value="">Select Station</option>
                  {stations.map(s => (
                    <option key={s.code} value={s.code}>{s.name} ({s.code})</option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">To Station</label>
                <select
                  value={formData.to}
                  onChange={(e) => setFormData({...formData, to: e.target.value})}
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                >
                  <option value="">Select Station</option>
                  {stations.map(s => (
                    <option key={s.code} value={s.code}>{s.name} ({s.code})</option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Journey Date</label>
                <input
                  type="date"
                  value={formData.date}
                  onChange={(e) => setFormData({...formData, date: e.target.value})}
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                />
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Class</label>
                <select
                  value={formData.class}
                  onChange={(e) => setFormData({...formData, class: e.target.value})}
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                >
                  {classes.map(c => (
                    <option key={c} value={c}>{c}</option>
                  ))}
                </select>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Quota</label>
                <select
                  value={formData.quota}
                  onChange={(e) => setFormData({...formData, quota: e.target.value})}
                  className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-transparent"
                >
                  {quotas.map(q => (
                    <option key={q} value={q}>{q}</option>
                  ))}
                </select>
              </div>
            </div>

            <button
              onClick={handleSearch}
              className="w-full bg-gradient-to-r from-orange-600 to-orange-500 text-white py-3 rounded-lg font-semibold hover:from-orange-700 hover:to-orange-600 transition-all shadow-md"
            >
              Search Trains
            </button>
          </div>
        )}

        {/* Results */}
        {activeTab === 'results' && (
          <div className="space-y-4">
            {trains.map(train => (
              <div key={train.number} className="bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow">
                <div className="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
                  <div>
                    <h3 className="text-xl font-bold text-gray-800">{train.number} - {train.name}</h3>
                    <p className="text-sm text-gray-600">{train.from} → {train.to}</p>
                  </div>
                  <div className="mt-2 md:mt-0">
                    <span className="bg-orange-100 text-orange-800 px-3 py-1 rounded-full text-sm font-medium">
                      Tatkal Opens: {train.tatkalOpen}
                    </span>
                  </div>
                </div>

                <div className="grid grid-cols-3 gap-4 mb-4">
                  <div className="text-center">
                    <Clock className="w-5 h-5 mx-auto mb-1 text-gray-600" />
                    <p className="text-sm font-semibold">{train.departure}</p>
                    <p className="text-xs text-gray-600">Departure</p>
                  </div>
                  <div className="text-center">
                    <p className="text-sm font-semibold text-orange-600">{train.duration}</p>
                    <p className="text-xs text-gray-600">Duration</p>
                  </div>
                  <div className="text-center">
                    <Clock className="w-5 h-5 mx-auto mb-1 text-gray-600" />
                    <p className="text-sm font-semibold">{train.arrival}</p>
                    <p className="text-xs text-gray-600">Arrival</p>
                  </div>
                </div>

                <div className="border-t pt-4">
                  <div className="flex flex-wrap gap-3 mb-4">
                    {Object.entries(train.available).map(([cls, count]) => (
                      <div key={cls} className="flex items-center space-x-2">
                        <span className="font-medium text-gray-700">{cls}:</span>
                        <span className={`font-bold ${count > 10 ? 'text-green-600' : count > 0 ? 'text-yellow-600' : 'text-red-600'}`}>
                          {count > 0 ? `${count} Available` : 'Waiting List'}
                        </span>
                      </div>
                    ))}
                  </div>

                  <button
                    onClick={() => handleAutoBook(train)}
                    className="w-full bg-gradient-to-r from-green-600 to-green-500 text-white py-2 rounded-lg font-semibold hover:from-green-700 hover:to-green-600 transition-all flex items-center justify-center space-x-2"
                  >
                    <Zap className="w-5 h-5" />
                    <span>Enable AI Auto-Book</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* Auto-Book Queue */}
        {activeTab === 'autobook' && (
          <div className="bg-white rounded-xl shadow-lg p-6">
            <h2 className="text-xl font-bold mb-6 flex items-center">
              <Zap className="w-6 h-6 mr-2 text-orange-600" />
              AI Auto-Book Queue
            </h2>

            {bookingAttempts.length === 0 ? (
              <div className="text-center py-12 text-gray-500">
                <Calendar className="w-16 h-16 mx-auto mb-4 text-gray-300" />
                <p>No booking attempts scheduled yet</p>
                <p className="text-sm mt-2">Search for trains and enable auto-booking to get started</p>
              </div>
            ) : (
              <div className="space-y-4">
                {bookingAttempts.map(attempt => (
                  <div key={attempt.id} className="border rounded-lg p-4">
                    <div className="flex items-start justify-between mb-3">
                      <div>
                        <h3 className="font-semibold text-lg">{attempt.trainNumber} - {attempt.trainName}</h3>
                        <p className="text-sm text-gray-600">Class: {attempt.class} | Scheduled: {attempt.scheduledTime}</p>
                      </div>
                      <span className={`px-3 py-1 rounded-full text-sm font-medium ${getStatusColor(attempt.status)}`}>
                        {attempt.status.toUpperCase()}
                      </span>
                    </div>

                    {attempt.status === 'success' && (
                      <div className="bg-green-50 border border-green-200 rounded-lg p-3 flex items-center space-x-3">
                        <CheckCircle className="w-5 h-5 text-green-600 flex-shrink-0" />
                        <div>
                          <p className="font-semibold text-green-800">Booking Successful!</p>
                          <p className="text-sm text-green-700">PNR: {attempt.pnr}</p>
                        </div>
                      </div>
                    )}

                    {attempt.status === 'attempting' && (
                      <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-3 flex items-center space-x-3">
                        <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-yellow-600"></div>
                        <p className="text-sm font-medium text-yellow-800">Attempting to book ticket...</p>
                      </div>
                    )}

                    {attempt.status === 'scheduled' && (
                      <div className="bg-blue-50 border border-blue-200 rounded-lg p-3 flex items-center space-x-3">
                        <AlertCircle className="w-5 h-5 text-blue-600 flex-shrink-0" />
                        <p className="text-sm font-medium text-blue-800">AI will automatically attempt booking at the scheduled time</p>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
};

export default TatkalBookingApp;
